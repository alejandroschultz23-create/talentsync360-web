# Google Tag Manager Container ID
NEXT_PUBLIC_GTM_ID=GTM-WSBC22RX

# WhatsApp Business Number (international wa.me format: e.g. 34600000000, no plus/spaces)
NEXT_PUBLIC_WHATSAPP_BUSINESS_NUMBER=WHATSAPP_BUSINESS_NUMBER_PLACEHOLDER

# Server-only Supabase access
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional Evidence Review receipt email (server-only)
RESEND_API_KEY=
EVIDENCE_REVIEW_FROM_EMAIL=

# H3 Talent Pilot (ALL server-only; NEVER prefix with NEXT_PUBLIC_)
# Private Cloud Run service URL (also the IAM ID-token audience).
H3_TALENT_PILOT_SERVICE_URL=
# H3 application credential (server-only secret; never exposed to the browser).
H3_TALENT_PILOT_SERVICE_CREDENTIAL=
# Product-issued pilot invitation/session signing secret (server-only secret).
H3_PILOT_INVITATION_SECRET=
# GCP Workload Identity Federation provider default audience (non-secret).
GCP_AUDIENCE=https://iam.googleapis.com/projects/29906783013/locations/global/workloadIdentityPools/talentsync360-vercel-pool/providers/talentsync360-vercel-provider
# Least-privilege Product BFF service account impersonated via WIF (non-secret).
GCP_SERVICE_ACCOUNT_EMAIL=talentsync360-h3-pilot-bff@hermes-ia-498018.iam.gserviceaccount.com
